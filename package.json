{
  "name": "vauvapeli",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run check:icons && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "npm run build && wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  }
}
