{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vauvapeli",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",

  // The PWA shell. Anything the router does not claim is served from here, and
  // a client-side route falls back to index.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },

  // One object per room code. This is the whole game server: the authoritative
  // state, every phone's socket, and the alarm that times the five second gap.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  // SQLite-backed, which is what the free plan allows. The room keeps a handful
  // of keys, so the storage backend makes no practical difference here.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "observability": { "enabled": true },
}
